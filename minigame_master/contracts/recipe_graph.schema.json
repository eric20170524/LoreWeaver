{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreweaver.local/contracts/recipe_graph.schema.json",
  "title": "LoreWeaver RecipeGraph",
  "type": "object",
  "required": ["schemaVersion", "entryNodeId", "nodes", "edges", "completionRules"],
  "properties": {
    "schemaVersion": {
      "const": "loreweaver.recipe-graph.v1"
    },
    "entryNodeId": {
      "type": "string",
      "minLength": 1
    },
    "sessionTargetMinutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240
    },
    "cyclePolicy": {
      "type": "string",
      "enum": ["forbid", "allow"]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["gameplay", "story", "system"]
          },
          "title": {"type": "string"},
          "recipeRef": {"type": ["string", "null"]},
          "sourceNodeId": {"type": ["string", "number", "null"]},
          "payload": {"type": ["object", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "when"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "priority": {"type": "integer"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "completionRules": {
      "type": "object",
      "required": ["type", "nodeIds"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["reach_any", "reach_all"]
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
