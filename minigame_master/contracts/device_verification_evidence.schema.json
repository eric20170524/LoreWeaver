{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreweaver.local/contracts/device_verification_evidence.schema.json",
  "title": "LoreWeaver Device Verification Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "releaseEligible",
    "cardId",
    "specHash",
    "payloadHash",
    "artifact",
    "artifactSha256",
    "createdAt",
    "identityMatches",
    "freshness",
    "fixture",
    "synthetic",
    "deviceObserved",
    "headless",
    "emulated",
    "observationSource",
    "performanceBudget",
    "runs",
    "summary"
  ],
  "properties": {
    "schemaVersion": {"const": "loreweaver.device-verification-evidence.v1"},
    "status": {"type": "string", "enum": ["passed", "failed", "stale"]},
    "releaseEligible": {"type": "boolean"},
    "cardId": {"type": "string", "minLength": 1},
    "specHash": {"type": "string", "minLength": 1},
    "recipeHash": {"type": ["string", "null"]},
    "contentHash": {"type": ["string", "null"]},
    "atlasHash": {"type": ["string", "null"]},
    "runtimeVersion": {"type": ["string", "null"]},
    "payloadHash": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "artifactSha256": {"type": "string", "minLength": 1},
    "browserReport": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "identityMatches": {"type": "boolean"},
    "freshness": {"type": "string", "enum": ["fresh", "stale"]},
    "staleReason": {"type": ["string", "null"]},
    "fixture": {"type": "boolean"},
    "synthetic": {"type": "boolean"},
    "deviceObserved": {"type": "boolean"},
    "headless": {"type": "boolean"},
    "emulated": {"type": "boolean"},
    "observationSource": {"type": "string", "minLength": 1},
    "performanceBudget": {
      "type": "object",
      "required": ["minP50Fps", "minMinFps"],
      "properties": {
        "minP50Fps": {"type": "number", "exclusiveMinimum": 0},
        "minMinFps": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "physicalDevice",
          "headless",
          "emulated",
          "deviceClass",
          "deviceModel",
          "os",
          "browser",
          "viewport",
          "completed",
          "interactionOk",
          "consoleErrors",
          "fps",
          "performanceBudgetMet"
        ],
        "properties": {
          "physicalDevice": {"type": "boolean"},
          "headless": {"type": "boolean"},
          "emulated": {"type": "boolean"},
          "deviceClass": {"type": "string", "minLength": 1},
          "deviceModel": {"type": "string", "minLength": 1},
          "os": {"type": "string", "minLength": 1},
          "browser": {"type": "string", "minLength": 1},
          "viewport": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "completed": {"type": "boolean"},
          "interactionOk": {"type": "boolean"},
          "consoleErrors": {"type": "integer", "minimum": 0},
          "fps": {
            "type": "object",
            "required": ["p50", "p95", "min"],
            "properties": {
              "p50": {"type": "number", "minimum": 0},
              "p95": {"type": "number", "minimum": 0},
              "min": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          },
          "performanceBudgetMet": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "runCount",
        "completedRunCount",
        "interactionFailureCount",
        "consoleErrorCount",
        "meetsPerformanceBudget",
        "passCriteria"
      ],
      "properties": {
        "runCount": {"type": "integer", "minimum": 1},
        "completedRunCount": {"type": "integer", "minimum": 0},
        "interactionFailureCount": {"type": "integer", "minimum": 0},
        "consoleErrorCount": {"type": "integer", "minimum": 0},
        "meetsPerformanceBudget": {"type": "boolean"},
        "passCriteria": {
          "type": "object",
          "required": [
            "allRunsPhysicalDevices",
            "allRunsCompleted",
            "zeroInteractionFailures",
            "zeroConsoleErrors",
            "meetsPerformanceBudget"
          ],
          "properties": {
            "allRunsPhysicalDevices": {"type": "boolean"},
            "allRunsCompleted": {"type": "boolean"},
            "zeroInteractionFailures": {"type": "boolean"},
            "zeroConsoleErrors": {"type": "boolean"},
            "meetsPerformanceBudget": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
