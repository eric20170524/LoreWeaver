{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreweaver.local/contracts/task_contract.schema.json",
  "title": "LoreWeaver Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sourceSpecHash",
    "productIntent",
    "acceptanceCriteria",
    "dependencies",
    "context",
    "runtimeStateContract",
    "patchAuthority",
    "status",
    "handoffRounds",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": "loreweaver.task-contract.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "sourceSpecHash": { "type": "string", "minLength": 8 },
    "productIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "userVisibleOutcome", "nonGoals"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "userVisibleOutcome": { "type": "string", "minLength": 1 },
        "nonGoals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "evidenceKinds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "evidenceKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["static", "runtime", "visual", "feel"]
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "architect", "programmer", "auditor", "player", "reviewer"],
      "properties": {
        "all": { "$ref": "#/$defs/contextEntries" },
        "architect": { "$ref": "#/$defs/contextEntries" },
        "programmer": { "$ref": "#/$defs/contextEntries" },
        "auditor": { "$ref": "#/$defs/contextEntries" },
        "player": { "$ref": "#/$defs/contextEntries" },
        "reviewer": { "$ref": "#/$defs/contextEntries" }
      }
    },
    "runtimeStateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "inputActions"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "type": { "enum": ["number", "string", "boolean", "object", "array"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inputActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "patchAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAutoLevel", "requestedLevel"],
      "properties": {
        "maxAutoLevel": { "const": "L2" },
        "requestedLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] }
      }
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "implemented",
        "static_verified",
        "runtime_verified",
        "reviewed",
        "accepted",
        "blocked",
        "escalated"
      ]
    },
    "resumeRole": {
      "type": ["string", "null"],
      "enum": ["architect", "programmer", "auditor", "player", "reviewer", null]
    },
    "handoffRounds": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoffRound" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "contextEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "status", "criterionIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["plan", "implementation", "static", "runtime", "visual", "feel", "review", "acceptance"] },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "unavailable", "stale"] },
        "criterionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fixture": { "type": "boolean", "default": false },
        "synthetic": { "type": "boolean", "default": false },
        "stale": { "type": "boolean", "default": false }
      }
    },
    "handoffRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "role",
        "verdict",
        "summary",
        "evidenceRefs",
        "findings",
        "previousRoundHash",
        "roundHash"
      ],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["architect", "programmer", "auditor", "player", "reviewer", "orchestrator"] },
        "verdict": { "enum": ["passed", "failed", "escalated"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "previousRoundHash": { "type": ["string", "null"] },
        "roundHash": { "type": "string", "minLength": 16 }
      }
    }
  }
}