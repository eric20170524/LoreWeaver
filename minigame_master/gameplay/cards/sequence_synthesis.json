{
  "schemaVersion": "2.0",
  "id": "sequence_synthesis",
  "title": "Sequence Synthesis",
  "category": "crafting_puzzle",
  "status": "runtime_ready",
  "runtime": {
    "engineTargets": [
      "phaser"
    ],
    "adapter": "SequenceSynthesisAdapter",
    "container": "phaser_scene",
    "template": "sequence_synthesis"
  },
  "inputs": [
    "pointer_down",
    "touch_tap",
    "keyboard_1_to_8"
  ],
  "objectives": [
    "complete_recipe_sequence"
  ],
  "failure": [
    "explosion_when_enabled",
    "timer_expired",
    "retreated",
    "hp_zero_if_external_damage"
  ],
  "knobs": {
    "recipeLength": {
      "type": "integer",
      "default": 4,
      "min": 1,
      "max": 20,
      "patchLevel": "L1",
      "description": "Number of ordered ingredients or actions."
    },
    "materialPoolSize": {
      "type": "integer",
      "default": 6,
      "min": 2,
      "max": 8,
      "patchLevel": "L1",
      "description": "Number of possible materials shown."
    },
    "wrongInputProgressPenalty": {
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 100,
      "patchLevel": "L1",
      "description": "Wrong input rewinds ceil(penalty * recipeLength / 100) accepted ingredients. Progress is the remaining accepted prefix; zero means no rollback."
    },
    "explodeOnConsecutiveMistakes": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 10,
      "patchLevel": "L1",
      "description": "Consecutive wrong inputs before hard reset or failure."
    },
    "explodeFails": {
      "type": "boolean",
      "default": false,
      "patchLevel": "L1",
      "description": "Consecutive mistakes hard-fail when true."
    },
    "allowQuit": {
      "type": "boolean",
      "default": true,
      "patchLevel": "L1",
      "description": "Allow retreat."
    },
    "allowPause": {
      "type": "boolean",
      "default": true,
      "patchLevel": "L1",
      "description": "Allow pause."
    },
    "runSeed": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 999999999,
      "patchLevel": "L1",
      "description": "Reproducible recipe and material-order seed, including 0. Never falls back to wall time."
    },
    "durationSec": {
      "type": "number",
      "default": 45,
      "min": 5,
      "max": 180,
      "patchLevel": "L1",
      "description": "Real round countdown; timeout always fails."
    },
    "playerHp": {
      "type": "number",
      "default": 100,
      "min": 1,
      "max": 300,
      "patchLevel": "L1",
      "description": "Initial health; regular material mistakes affect prefix/overheat, not HP."
    }
  },
  "patchPolicy": {
    "defaultAllowedLevels": [
      "L0",
      "L1",
      "L2"
    ],
    "requiresReview": [
      "L3",
      "L4"
    ]
  },
  "requiredCoreSystems": [
    "RecipeState",
    "InputOrderJudge",
    "ProgressBar",
    "VFX",
    "NodeResult"
  ],
  "resultContract": {
    "successReason": "objective_met",
    "telemetry": [
      "mistakes",
      "recipeLength",
      "elapsedSec",
      "progress",
      "stepsCompleted",
      "resets",
      "runSeed",
      "timeRemaining"
    ]
  },
  "testFixture": {
    "type": "browser",
    "path": "productize/jobs/run-sequence-card-lab-e2e.mjs",
    "assertions": [
      "real material input completes the recipe",
      "wrong material rewinds actual prefix",
      "overheat reset and optional failure",
      "real timeout fails",
      "pause input and countdown freeze",
      "restart clears result and seed zero is reproducible",
      "mobile touch completes recipe",
      "same static bundle starts offline"
    ]
  },
  "sourceProvenance": [
    "minigame/Path_to_Immortality/node11.html"
  ],
  "fit": {
    "goodFor": [
      "alchemy",
      "crafting",
      "ritual order",
      "lock sequence"
    ],
    "poorFor": [
      "reflex-only action nodes"
    ]
  },
  "knownRisks": [
    "No physical-device/FPS/soak certification",
    "Long authored localization needs visual review",
    "Whole-ingredient rollback intentionally replaces cosmetic progress penalties",
    "Legacy forceComplete demo helper is opt-in only and is never used by real-input card lab tests"
  ],
  "implementationNotes": "Shared RuntimeKernel/core adapter. Material pool 2-8, recipe 1-20; pointer/touch or visible number key. Seeded Fisher-Yates; actual prefix rollback, real countdown, terminal/lifecycle guards. Current browser results are tied to CI source revision.",
  "requiredAssets": {
    "playerClips": [
      "idle"
    ],
    "enemyKinds": [
      "hazard"
    ],
    "environments": [
      "bg_default"
    ],
    "audioCues": [
      "bgm_main",
      "sfx_hit",
      "sfx_win",
      "sfx_lose"
    ]
  },
  "performanceBudget": {
    "normalP95Fps": 55,
    "bossP95Fps": 45,
    "maxActiveEnemies": 8
  },
  "maturityImpact": {
    "dimensions": [
      "gameplay",
      "visual",
      "audio",
      "e2e"
    ],
    "notes": "Migrated to Gameplay Card V2 maturity model."
  },
  "testScenarios": [
    {
      "id": "smoke_test",
      "tags": [
        "smoke",
        "runtime"
      ]
    },
    {
      "id": "demo_e2e_enter_retreat_fail_win",
      "tags": [
        "e2e",
        "demo",
        "gate"
      ]
    }
  ],
  "exportPolicy": {
    "productionReady": false,
    "blockReason": "Current revision requires per-card browser, device, visual and export validation; historical demo certification is not inherited."
  },
  "historicalCertification": {
    "status": "production_ready",
    "exportPolicy": {
      "productionReady": true,
      "blockReason": null,
      "conditionalWaivers": [
        "device_class_fps: headless soak avgFps proxy",
        "vlm_visual_overflow: deferred; deterministic visual_audit used",
        "standalone_zip_host_e2e: demo browser gate primary for sequence puzzle card"
      ]
    },
    "notes": {
      "status": "production_ready",
      "certifiedAt": "2026-07-24",
      "demo": "minigame_master/core/demo/sequence_synthesis",
      "e2eScript": "npm run check:seq-e2e:release",
      "visualSoakScript": "npm run check:seq-visual-soak:release",
      "readinessScript": "npm run check:seq-gate",
      "fixtures": "minigame_master/gameplay/cards/fixtures/sequence_synthesis/",
      "humanSignoff": "docs/reports/step_E3_sequence_synthesis_human_playtest_signoff.md",
      "evidence": [
        "runtime_e2e_sequence_synthesis_latest.json",
        "standalone_browser_report_sequence_synthesis.json",
        "visual_audit_sequence_synthesis_latest.json",
        "performance_report_sequence_synthesis_latest.json",
        "seq_gate_readiness_latest.json",
        "level_recipe_compile_seq_latest.json"
      ],
      "residuals": [
        "true device-class FPS P95",
        "VLM overflow/HUD audit",
        "full standalone export host E2E matrix"
      ]
    }
  }
}
